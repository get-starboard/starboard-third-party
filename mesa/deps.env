# Pinned inputs of mesa/build.sh.
MESA_VERSION=26.3.0-rc2
MESA_URL=https://archive.mesa3d.org/mesa-26.3.0-rc2.tar.xz
# Test only: computed from the archive's tarball, which publishes no checksum for RCs.
MESA_SHA256=6b9154bc46ec73901555dbcb61600eb69607dc1da718a87e7a1c09a755bb1b6d
# The build container. Its glibc (2.41) must not be newer than the rootfs's.
BUILD_IMAGE=debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
# Debian archive snapshot the build tools come from, so a later rebuild gets the same.
APT_SNAPSHOT=20261024T000000Z
# The newest glibc symbol version a library may need: the rootfs's libc6. The rootfs is
# bookworm with trixie's libc6, pulled in by trixie's libstdc++6; if that changes, change this.
GLIBC_LIMIT=2.41
