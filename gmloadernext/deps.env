# Pinned inputs of gmloadernext/build.sh.
GMLOADER_REPO=https://github.com/JohnnyonFlame/gmloader-next
# The commit's date in UTC. Its 2024.14 branch is gone, but it can still be fetched by hash.
GMLOADER_VERSION=20251118
GMLOADER_COMMIT=fc7c7174693497569ca1210e7b55b22d143b57c9
# The build container, for its older glibc and GCC 10. Matches PortMaster's build of this commit.
BUILD_IMAGE=debian:bullseye@sha256:6f519a81440354a85eb592c5f32109ab80605f6b892455983a6f618bf87fabe9
# BUILD_IMAGE's own Debian snapshot. Its packages must match the arm64 ones installed beside them.
APT_SNAPSHOT=20260824T000000Z
