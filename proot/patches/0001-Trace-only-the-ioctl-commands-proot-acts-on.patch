From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: David Stephens <dave@force9.org>
Date: Sat, 24 Oct 2026 16:14:50 +0100
Subject: [PATCH 1/2] Trace only the ioctl commands proot acts on

The seccomp filter traced every ioctl, so each GPU driver submit and
wait stopped in the tracer. It now traces SIOCGIFINDEX, the termios
commands and FICLONE, and lets other ioctls run.
---
 src/syscall/seccomp.c | 81 +++++++++++++++++++++++++++++++++++--------
 1 file changed, 66 insertions(+), 15 deletions(-)

diff --git a/src/syscall/seccomp.c b/src/syscall/seccomp.c
index 2f8930e..9dbde23 100644
--- a/src/syscall/seccomp.c
+++ b/src/syscall/seccomp.c
@@ -18,6 +18,9 @@
  * along with this program; if not, write to the Free Software
  * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA
  * 02110-1301 USA.
+ *
+ * Modified by the Starboard project (https://get-starboard.app),
+ * 2026-10-24: ioctl is traced only for the commands PRoot acts on.
  */
 
 #include "build.h"
@@ -38,6 +41,9 @@
 #include <stddef.h>        /* offsetof(3), */
 #include <stdint.h>        /* uint*_t, UINT*_MAX, */
 #include <assert.h>        /* assert(3), */
+#include <termios.h>       /* TCSETS, TCGETS2, TCSETS2, TCSETSW2, TCSETSF2 */
+#include <linux/sockios.h> /* SIOCGIFINDEX */
+#include <sys/ioctl.h>     /* _IOW */
 
 #include "syscall/seccomp.h"
 #include "tracee/tracee.h"
@@ -121,13 +127,56 @@ static int add_trace_syscall(struct sock_fprog *program, word_t syscall, int fla
 	return 0;
 }
 
+/* The ioctl commands enter.c, exit.c or an extension act on; keep in
+ * step with them.  Other ioctls are not traced.  */
+static const uint32_t traced_ioctls[] = {
+	SIOCGIFINDEX,
+	TCSETS + 2 /* TCSETSF */,
+	TCGETS2,
+	TCSETS2,
+	TCSETSW2,
+	TCSETSF2,
+	_IOW(0x94, 9, int) /* FICLONE */,
+};
+#define NB_TRACED_IOCTLS (sizeof(traced_ioctls) / sizeof(traced_ioctls[0]))
+#define LENGTH_TRACE_IOCTL (NB_TRACED_IOCTLS + 4)
+
+/**
+ * Like add_trace_syscall(), for ioctl: notify PRoot only when the command
+ * is in traced_ioctls[].  This function returns -errno if an error
+ * occurred, otherwise 0.
+ */
+static int add_trace_ioctl(struct sock_fprog *program, word_t syscall, int flag)
+{
+	const size_t cmd_offset = offsetof(struct seccomp_data, args[1]);
+	struct sock_filter statements[LENGTH_TRACE_IOCTL];
+	size_t i, n = 0;
+
+	if (syscall > UINT32_MAX)
+		return -ERANGE;
+
+	/* Not ioctl: skip this block.  */
+	statements[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K, syscall, 0, LENGTH_TRACE_IOCTL - 1);
+	/* Load the command's low 32 bits.  */
+	statements[n++] = (struct sock_filter) BPF_STMT(BPF_LD + BPF_W + BPF_ABS, cmd_offset);
+	for (i = 0; i < NB_TRACED_IOCTLS; i++)
+		statements[n++] = (struct sock_filter) BPF_JUMP(BPF_JMP + BPF_JEQ + BPF_K,
+						traced_ioctls[i], NB_TRACED_IOCTLS - i, 0);
+	statements[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_ALLOW);
+	statements[n++] = (struct sock_filter) BPF_STMT(BPF_RET + BPF_K, SECCOMP_RET_TRACE + flag);
+
+	DEBUG_FILTER("FILTER:     trace if syscall == %ld and cmd is listed\n", syscall);
+
+	return add_statements(program, LENGTH_TRACE_IOCTL, statements);
+}
+
 /**
  * Append to @program->filter the statements that allow anything (if
- * unfiltered).  Note that @nb_traced_syscalls is used to make a
+ * unfiltered).  Note that @nb_trace_statements is used to make a
  * sanity check.  This function returns -errno if an error occurred,
  * otherwise 0.
  */
-static int end_arch_section(struct sock_fprog *program, size_t nb_traced_syscalls)
+static int end_arch_section(struct sock_fprog *program, size_t nb_trace_statements)
 {
 	int status;
 
@@ -144,7 +193,7 @@ static int end_arch_section(struct sock_fprog *program, size_t nb_traced_syscall
 
 	/* Sanity check, see start_arch_section().  */
 	if (   talloc_array_length(program->filter) - program->len
-	    != LENGTH_END_SECTION + nb_traced_syscalls * LENGTH_TRACE_SYSCALL)
+	    != LENGTH_END_SECTION + nb_trace_statements)
 		return -ERANGE;
 
 	return 0;
@@ -152,16 +201,15 @@ static int end_arch_section(struct sock_fprog *program, size_t nb_traced_syscall
 
 /**
  * Append to @program->filter the statements that check the current
- * @architecture.  Note that @nb_traced_syscalls is used to make a
+ * @architecture.  Note that @nb_trace_statements is used to make a
  * sanity check.  This function returns -errno if an error occurred,
  * otherwise 0.
  */
-static int start_arch_section(struct sock_fprog *program, uint32_t arch, size_t nb_traced_syscalls)
+static int start_arch_section(struct sock_fprog *program, uint32_t arch, size_t nb_trace_statements)
 {
 	const size_t arch_offset    = offsetof(struct seccomp_data, arch);
 	const size_t syscall_offset = offsetof(struct seccomp_data, nr);
-	const size_t section_length = LENGTH_END_SECTION +
-					nb_traced_syscalls * LENGTH_TRACE_SYSCALL;
+	const size_t section_length = LENGTH_END_SECTION + nb_trace_statements;
 	int status;
 
 	/* Sanity checks.  */
@@ -191,7 +239,7 @@ static int start_arch_section(struct sock_fprog *program, uint32_t arch, size_t
 	};
 
 	DEBUG_FILTER("FILTER: if arch == %ld, up to %zdth statement\n",
-		arch, nb_traced_syscalls);
+		arch, nb_trace_statements);
 
 	status = add_statements(program, LENGTH_START_SECTION, statements);
 	if (status < 0)
@@ -256,7 +304,7 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 	size_t nb_archs = sizeof(seccomp_archs) / sizeof(SeccompArch);
 
 	struct sock_fprog program = { .len = 0, .filter = NULL };
-	size_t nb_traced_syscalls;
+	size_t nb_trace_statements;
 	size_t i, j, k;
 	int status;
 
@@ -268,19 +316,20 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 	for (i = 0; i < nb_archs; i++) {
 		word_t syscall;
 
-		nb_traced_syscalls = 0;
+		nb_trace_statements = 0;
 
-		/* Pre-compute the number of traced syscalls for this architecture.  */
+		/* Pre-compute the number of trace statements for this architecture.  */
 		for (j = 0; j < seccomp_archs[i].nb_abis; j++) {
 			for (k = 0; sysnums[k].value != PR_void; k++) {
 				syscall = detranslate_sysnum(seccomp_archs[i].abis[j], sysnums[k].value);
 				if (syscall != SYSCALL_AVOIDER)
-					nb_traced_syscalls++;
+					nb_trace_statements += sysnums[k].value == PR_ioctl
+						? LENGTH_TRACE_IOCTL : LENGTH_TRACE_SYSCALL;
 			}
 		}
 
 		/* Filter: if handled architecture */
-		status = start_arch_section(&program, seccomp_archs[i].value, nb_traced_syscalls);
+		status = start_arch_section(&program, seccomp_archs[i].value, nb_trace_statements);
 		if (status < 0)
 			goto end;
 
@@ -292,14 +341,16 @@ static int set_seccomp_filters(const FilteredSysnum *sysnums)
 					continue;
 
 				/* Filter: trace if handled syscall */
-				status = add_trace_syscall(&program, syscall, sysnums[k].flags);
+				status = sysnums[k].value == PR_ioctl
+					? add_trace_ioctl(&program, syscall, sysnums[k].flags)
+					: add_trace_syscall(&program, syscall, sysnums[k].flags);
 				if (status < 0)
 					goto end;
 			}
 		}
 
 		/* Filter: allow untraced syscalls for this architecture */
-		status = end_arch_section(&program, nb_traced_syscalls);
+		status = end_arch_section(&program, nb_trace_statements);
 		if (status < 0)
 			goto end;
 	}
